# ==========================================
# PaperPilot Environment Configuration
# ==========================================

FLASK_ENV=development
PORT=5000
SECRET_KEY=change_this_to_a_secure_random_key_in_production
MAX_CONTENT_LENGTH=104857600
FILE_RETENTION_SECONDS=3600

# ==========================================
# Razorpay Payment Gateway (Test / Live)
# Obtain Test API Keys from Razorpay Dashboard:
# https://dashboard.razorpay.com (Settings > API Keys)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# Outgoing SMTP / Contact Email Settings
# Set your SMTP credentials below to enable live email delivery:
# ==========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com
CONTACT_RECIPIENT=patilnishant787@gmail.com

# ==========================================
# Optional External OCR & AI Engines
# ==========================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OPENAI_API_KEY=
GEMINI_API_KEY=
